# Configuração do build do app (Capacitor). Copie para `.env.capacitor` — esse
# arquivo não é versionado; só o `.example` fica no repositório.
#
# Diferente do build web, o app roda dentro de um WebView (`https://localhost`
# no Android e `capacitor://localhost` no iOS). Por isso:
#   - `VITE_API_BASE_URL` é OBRIGATÓRIO, absoluto e em HTTPS. Um caminho
#     relativo (`/api`) apontaria para o próprio bundle do app.
#   - O host precisa estar acessível pelo aparelho (rede local ou internet) e
#     servir o backend com TLS válido — o app não abre exceção para HTTP.
#   - A CSP do app é injetada no `index.html` a partir desta URL (origem da API
#     e do WebSocket), porque no app não existe Nginx. Se usar PMTiles, a origem
#     do `VITE_PMTILES_URL` também entra no `connect-src`.
#   - O backend precisa aceitar a origem do WebView no handshake do STOMP:
#     `REALTIME_ALLOWED_ORIGINS=https://localhost,capacitor://localhost`
#     (além das origens web que já estiverem configuradas). Isso é allow-list
#     de WebSocket, não CORS: a API continua sem origem cruzada.
#
# Troque pelo endereço real do backend antes de gerar o APK:
VITE_API_BASE_URL=https://maraberto.example.org

# Restante igual ao `.env` do build web. Nada aqui pode ser regional: a
# instalação é que define o centro do mapa pelo Region Pack (ADR-003).
VITE_MAP_DEFAULT_CENTER=[-51.9253, -14.2350]
VITE_MAP_DEFAULT_ZOOM=4
VITE_MAP_BOUNDS=[[-73.99, -33.75], [-34.79, 5.27]]
VITE_APP_NAME=MarAberto
VITE_ORGANIZATION_NAME=Instituto Mar Aberto

# Acesso demo é só para desenvolvimento no navegador; no app use o login real.
VITE_DEMO_AUTH=false

# Opcional: tiles vetoriais do órgão (precisa ser HTTPS e entrar na CSP).
VITE_PMTILES_URL=
