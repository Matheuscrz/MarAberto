# Configuração do frontend (copie para `.env`; o arquivo `.env` não é versionado).
#
# Centro/zoom iniciais do mapa e limites opcionais ([[oeste,sul],[leste,norte]]).
# Os padrões apontam para o Brasil: nada aqui é específico de um estado.
VITE_MAP_DEFAULT_CENTER=[-51.9253, -14.2350]
VITE_MAP_DEFAULT_ZOOM=4
VITE_MAP_BOUNDS=[[-73.99, -33.75], [-34.79, 5.27]]
VITE_APP_NAME=MarAberto
VITE_ORGANIZATION_NAME=Instituto Mar Aberto

# Deixe vazio para usar a mesma origem: o Vite (dev) e o Nginx (produção)
# fazem proxy de /api. O cookie de refresh só funciona na mesma origem.
VITE_API_BASE_URL=

# Login fictício das áreas restritas, só em desenvolvimento. O padrão é o login
# real; habilite apenas para validar a interface sem backend.
VITE_DEMO_AUTH=false

# PMTiles (opcional): quando definido, o mapa usa os tiles vetoriais do órgão.
VITE_PMTILES_URL=

# Basemap de demonstração usado enquanto não há PMTiles. A origem precisa estar
# liberada na CSP: no Nginx (`nginx.conf`) e no build do app (`vite.config.ts`,
# que lê esta variável). Ao servir PMTiles do próprio domínio, esvazie esta
# variável e remova `https://tile.openstreetmap.org` da CSP do Nginx.
VITE_DEMO_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
