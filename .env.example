# Credenciais de desenvolvimento local do MarAberto.
# Copie este arquivo para .env antes de subir a stack: cp .env.example .env
# Estes padrões são apenas para desenvolvimento local — nunca use em produção.

# PostgreSQL 16 + PostGIS (host localhost, porta abaixo)
POSTGRES_DB=maraberto
POSTGRES_USER=maraberto
POSTGRES_PASSWORD=maraberto
POSTGRES_PORT=5432

# Redis 7.x
REDIS_PORT=6379

# Garage — armazenamento S3-compatível (ADR-006).
# API S3 em http://localhost:9000, API admin em http://localhost:9001,
# bucket padrão criado automaticamente no primeiro start.
GARAGE_ACCESS_KEY=maraberto-access-key
GARAGE_SECRET_KEY=maraberto-secret-key
GARAGE_BUCKET=media-public
GARAGE_S3_PORT=9000
GARAGE_ADMIN_PORT=9001

# RabbitMQ 3 — console de gestão em http://localhost:15672, AMQP na porta 5672
RABBITMQ_USER=maraberto
RABBITMQ_PASSWORD=maraberto
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
