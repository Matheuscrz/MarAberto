# Credenciais de desenvolvimento local do MarAberto.
# Copie este arquivo para .env antes de subir a stack: cp .env.example .env
# Estes padrões são apenas para desenvolvimento local — nunca use em produção.

# PostgreSQL 16 + PostGIS (host localhost, porta abaixo)
POSTGRES_DB=maraberto
POSTGRES_USER=maraberto
POSTGRES_PASSWORD=maraberto
POSTGRES_PORT=5432

# Redis 7.x
REDIS_PORT=6379

# Garage — armazenamento S3-compatível (ADR-006).
# API S3 em http://localhost:9000, API admin em http://localhost:9001,
# bucket padrão criado automaticamente no primeiro start.
GARAGE_ACCESS_KEY=maraberto-access-key
GARAGE_SECRET_KEY=maraberto-secret-key
GARAGE_BUCKET=media-public
GARAGE_S3_PORT=9000
GARAGE_ADMIN_PORT=9001

# RabbitMQ 3 — console de gestão em http://localhost:15672, AMQP na porta 5672
RABBITMQ_USER=maraberto
RABBITMQ_PASSWORD=maraberto
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Criptografia de dados sensíveis (AES-256-GCM) — ver docs/adr/012.
# A chave abaixo é APENAS de desenvolvimento e é recusada no perfil `prod`.
# Em qualquer ambiente compartilhado, gere 32 bytes aleatórios:
#   openssl rand -base64 32
# e mantenha o valor fora do repositório (gerenciador de segredos).
CRYPTO_KEY_ID=k1
CRYPTO_MASTER_KEY=ZGV2LW9ubHktbWFyYWJlcnRvLWtleS0zMmJ5dGVzISE=

# Segredo do JWT de acesso (mínimo 32 bytes) — ver ADR-009.
# O valor abaixo é APENAS de desenvolvimento e é recusado no perfil `prod`.
# Em qualquer ambiente compartilhado, gere um segredo e mantenha fora do repositório:
#   openssl rand -base64 48
JWT_SECRET=dev-only-maraberto-jwt-secret-32bytes!!
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P7D

# Contas de desenvolvimento (operador@, coordenador@ e admin@maraberto.dev,
# senha demo1234). Deixe `false` em qualquer ambiente compartilhado.
IDENTITY_DEV_SEED=true

# Origens permitidas para WebSocket/STOMP (separadas por vírgula)
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
